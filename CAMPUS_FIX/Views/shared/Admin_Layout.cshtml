
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Admin_Layout</title>
    <script src="~/content/bootstrap/js/jquery-3.7.1.min.js"></script>
    <link href="~/content/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/content/css/StyleSheet1.css" rel="stylesheet" />
    <script src="~/content/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/content/bootstrap/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>

    <div class="container-fluid">
        <!--start header section-->
        <div class="row border shadow">

            <div class="col-sm-4 text-center bg-info">
                <img src="\content\images\logo.png" style="height:80px;" />
            </div>

            <div class="col-sm-8 bg-info">
                <h1 class="fw-bold mt-2 text-center">Welcome to Admin Zone</h1>
            </div>

        </div>
        <!--end header section-->
        @*start navbar section@*@
        <div class="row">

            <nav class="navbar navbar-expand-lg bg-body-tertiary shadow">
                <div class="container-fluid">
                    <a class="navbar-brand fw-bold">Campus Fix</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto gap-5">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Admin/Index">Dashboard</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>

        </div>
        @*end navbar section@*@

        <!--start Child page section-->
            @RenderBody()
        <!--end Child page section-->
        <!--start footer section-->
        <div class="row bg-dark text-light px-5">

            <div class="col-sm-1"></div>
            <div class="col-sm-3 p-4">
                <h3>About Us</h3><hr />
                <p style="text-align:justify">
                    The Campus Event Management System is a streamlined digital platform designed to automate the
                    announcement and registration process for college activities.
                </p>
            </div>

            <div class="col-sm-4 px-5 py-4">
                <h3>Important Links</h3><hr />
                <div class="row">
                    <div class="col-sm-6">
                        <ul type="none" class="mt-3 p-0">
                            <li><a href="\General\Index" class="text-decoration-none text-light">Home</a></li>
                            <li><a href="\general\AboutUs" class="text-decoration-none text-light">About Us</a></li>
                        </ul>
                    </div>
                    <div class="col-sm-6">
                        <ul type="none" class="mt-3 p-0">
                            <li><a href="\General\ReportComplaint" class="text-decoration-none text-light">Report Complaint</a></li>
                            <li><a href="\General\ContactUs" class="text-decoration-none text-light">ContactUS</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-sm-3 p-4">
                <h3>Folllow Link</h3><hr />
                <p class="d-flex gap-4 text-center">
                    <a href="#" class="text-decoration-none text-danger"><i class="bi bi-instagram fs-3"></i></a>
                    <a href="#" class="text-decoration-none text-primary"><i class="bi bi-facebook fs-3"></i></a>
                    <a href="#" class="text-decoration-none text-light"><i class="bi bi-twitter-x fs-3"></i></a>
                    <a href="#" class="text-decoration-none text-danger"><i class="bi bi-youtube fs-3"></i></a>
                </p>
            </div>
            <div class="col-sm-1"></div><hr />

            <div class="col-sm-12 text-center">
                <p>&copy; Copyrights &emsp;&emsp;<a href="\General\DeveloperPage" class="text-decoration-none">Developed By Code Warriors Team</a></p>
            </div>

        </div>
        <!--end footer section-->
    </div>
</body>
</html>
