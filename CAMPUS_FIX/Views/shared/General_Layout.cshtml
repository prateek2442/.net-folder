    @*start modal*@
    <!-- Button trigger modal -->
    <button type="button" class="btn btn-primary enquiry-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">
        Enquiry
    </button>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button> 
                </div>
                <form action="\General\SaveEnquiry" method="post">
                    <div class="modal-body">

                        <!--Name-->
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" name="Name" id="floatingName" placeholder="Name">
                            <label for="floatingName"><i class="bi bi-person-fill"></i> Name</label>
                        </div>

                        <!--Email-->
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" name="Email" id="floatingEmail" placeholder="Email">
                            <label for="floatingEmail"><i class="bi bi-envelope-at-fill"></i> Email</label>
                        </div>

                        <!--Mobile Number-->
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control" id="floatingNumebr" name="MobileNo" placeholder="Mobile Number">
                            <label for="floatingEmail"><i class="bi bi-telephone-forward-fill"></i> Mobile Number</label>
                        </div>

                        <!--Subject-->
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="floatingSubject" name="Subject" placeholder="Subject">
                            <label for="floatingSubject"><i class="bi bi-chat-text"></i> Subject</label>
                        </div>

                        <!--Message--> 
                        <div class="form-floating mb-3">
                            <textarea type="number" class="form-control" id="floatingMessage" name="Message" placeholder="Message"></textarea>
                            <label for="floatingMessage"><i class="bi bi-chat-dots-fill"></i> Message</label>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Send Enquiry</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
    @*end modal*@

</body>
