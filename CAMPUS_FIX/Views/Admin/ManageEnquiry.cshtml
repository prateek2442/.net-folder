
@{
    ViewBag.Title = "ManageEnquiry";
    Layout = "~/Views/shared/Admin_Layout.cshtml";
}
@using CAMPUS_FIX.Models
@model List<Enquiry_Master>

<div class="row p-5" style="min-height:400px">
    <div class="col-sm-10 py-1">
        <div class="card">
            <!--start table-->
            <p>@TempData["message"]</p>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr class="table-success">
                            <th>S.N</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>mobile number</th>
                            <th>Subject</th>
                            <th>message</th>
                            <th>EnquiryDate</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{ 
                            int sno = 1;
                            foreach(Enquiry_Master em in Model)
                            {
                                <tr>
                                    <td>@sno</td>
                                    <td>@em.Name</td>
                                    <td>@em.Email</td>
                                    <td>@em.MobileNo</td>
                                    <td>@em.Subject</td>
                                    <td>@em.Message</td>
                                    <td>@em.EnquiryDate</td>
                                    <td> <a href="/Admin/DeleteEnquiry?id=@em.EnqId" class="text-decoration-none bg-danger border rounded-3 btn-group-lg text-light p-2"><i class="bi bi-trash3-fill"></i>delete</a></td>
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

