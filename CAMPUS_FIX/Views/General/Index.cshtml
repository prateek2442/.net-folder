
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/shared/General_Layout.cshtml";
}
@using CAMPUS_FIX.Models
@model List<Notification_Master>


<div class="container-fluid" style="background-color:antiquewhite;">
    <div class="row noti">
        <div class="col-sm-12  ">
            <marquee scrollamunt="20" onmouseover="stop()" onmouseleave="start()">
                @{ 
                    foreach(Notification_Master nm in Model)
            {
                                <i class="bi bi-bell-fill"></i>
                                <span>@nm.NotiMessage</span>
            }
                }

            </marquee>
        </div>


        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <img src="~/content/images/slider-img2.png" class="img-fluid w-100 rounded shadow-sm" style="height:250px; object-fit:cover;" alt="Image 1" />
