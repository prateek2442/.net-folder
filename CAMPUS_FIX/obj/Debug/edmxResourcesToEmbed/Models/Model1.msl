<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="ComplaintdbModelStoreContainer" CdmEntityContainer="ComplaintdbEntities">
    <EntitySetMapping Name="Complaint_Master">
      <EntityTypeMapping TypeName="ComplaintdbModel.Complaint_Master">
        <MappingFragment StoreEntitySet="Complaint_Master">
          <ScalarProperty Name="ComplaintId" ColumnName="ComplaintId" />
          <ScalarProperty Name="FacilityType" ColumnName="FacilityType" />
          <ScalarProperty Name="Location" ColumnName="Location" />
          <ScalarProperty Name="IssueDetails" ColumnName="IssueDetails" />
          <ScalarProperty Name="Status" ColumnName="Status" />
          <ScalarProperty Name="ReportDate" ColumnName="ReportDate" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Enquiry_Master">
      <EntityTypeMapping TypeName="ComplaintdbModel.Enquiry_Master">
        <MappingFragment StoreEntitySet="Enquiry_Master">
          <ScalarProperty Name="EnqId" ColumnName="EnqId" />
          <ScalarProperty Name="Name" ColumnName="Name" />
          <ScalarProperty Name="Email" ColumnName="Email" />
          <ScalarProperty Name="MobileNo" ColumnName="MobileNo" />
          <ScalarProperty Name="Subject" ColumnName="Subject" />
          <ScalarProperty Name="Message" ColumnName="Message" />
          <ScalarProperty Name="EnquiryDate" ColumnName="EnquiryDate" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="login_Master">
      <EntityTypeMapping TypeName="ComplaintdbModel.login_Master">
        <MappingFragment StoreEntitySet="login_Master">
          <ScalarProperty Name="AdminId" ColumnName="AdminId" />
          <ScalarProperty Name="Password" ColumnName="Password" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Notification_Master">
      <EntityTypeMapping TypeName="ComplaintdbModel.Notification_Master">
        <MappingFragment StoreEntitySet="Notification_Master">
          <ScalarProperty Name="NotiId" ColumnName="NotiId" />
          <ScalarProperty Name="NotiMessage" ColumnName="NotiMessage" />
          <ScalarProperty Name="AddedOn" ColumnName="AddedOn" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>